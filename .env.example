# Frontend runtime configuration
# Copy to .env.local for local development.

# Your backend API base URL (separate host from frontend is supported).
# Example: https://api.yourdomain.com
VITE_API_BASE_URL=

# Set to false once your backend auth endpoints are ready.
VITE_ENABLE_MOCK_AUTH=true

# Global request timeout for API calls (ms)
VITE_REQUEST_TIMEOUT_MS=10000

# Optional Shopify Storefront API settings (future integration)
# Example URL: https://your-store.myshopify.com/api/2024-10/graphql.json
VITE_SHOPIFY_STOREFRONT_API_URL=
VITE_SHOPIFY_STOREFRONT_TOKEN=
